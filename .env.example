# Copy to .env and fill in. The system runs fine without a key:
# the agent layer is skipped and the deterministic diagnosis is shown, labelled "no agent".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Slack alerts (optional) ---------------------------------------------
# One message per confirmed incident, carrying the card: cause, cost, conversion and
# the recommended action. Leave empty and alerting stays off, the same way an empty
# OPENAI_API_KEY turns the agent off.
# Create the URL at https://api.slack.com/messaging/webhooks (Incoming Webhooks).
# Treat it as a credential: anyone holding it can post to your channel.
SLACK_WEBHOOK_URL=
# Only alert above this rate. 0 = every confirmed incident.
CT_SLACK_MIN_COST_PER_MIN=0
# Where this server is reachable, for the "Open incident" button. Empty = no button.
CT_PUBLIC_BASE_URL=http://localhost:8000

# --- Ask Control Tower in Slack (optional) --------------------------------
# Mention the bot in the channel and it answers from live state: "@ControlTower what's
# going on?", or a reply inside an alert's thread, where "is it fixed?" already knows
# which incident you mean.
#
# Needs a Slack app with: bot scopes app_mentions:read + chat:write, Event Subscriptions
# pointed at  <public url>/api/slack/events  subscribed to `app_mention`, and the app
# invited to the channel. The URL must be reachable from Slack (ngrok works for a demo).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL=
